<Project>
  <PropertyGroup>
    <Version>0.1.0</Version>
    <PackageVersion>$(Version)</PackageVersion>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <DeterministicTimestamp>2020-01-01T00:00:00Z</DeterministicTimestamp>
    <ContinuousIntegrationBuild Condition="'$(ContinuousIntegrationBuild)' == ''">true</ContinuousIntegrationBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>8.0-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors Condition="'$(Configuration)' == 'Release'">true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CA1305</NoWarn>
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <RepositoryUrl>https://github.com/KeelMatrix/EfGuard</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsPackable)' == 'true'">
    <Authors>KeelMatrix</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/KeelMatrix/EfGuard#readme</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
  </ItemGroup>

  <Target Name="RejectSensitiveFilesInPack" AfterTargets="_GetPackageFiles" Condition="'$(IsPackable)' == 'true'">
    <ItemGroup>
      <_ForbiddenPackageFile Include="@(_PackageFiles)" Condition="
        $([System.Text.RegularExpressions.Regex]::IsMatch('%(_PackageFiles.Filename)', '(?i)^\.env')) Or
        $([System.Text.RegularExpressions.Regex]::IsMatch('%(_PackageFiles.Filename)', '(?i)^appsettings')) Or
        $([System.Text.RegularExpressions.Regex]::IsMatch('%(_PackageFiles.Filename)', '(?i)^local\.settings')) Or
        ('%(_PackageFiles.Extension)' == '.json' And $([System.Text.RegularExpressions.Regex]::IsMatch('%(_PackageFiles.Filename)', '(?i)^keelmatrix\.telemetry'))) Or
        '%(_PackageFiles.Filename)' == 'AGENTS' Or
        '%(_PackageFiles.Filename)' == 'global' Or
        '%(_PackageFiles.Filename)' == 'NuGet' Or
        '%(_PackageFiles.Filename)' == 'Directory.Build' Or
        '%(_PackageFiles.Filename)' == 'Directory.Packages' Or
        '%(_PackageFiles.Filename)' == '.editorconfig' Or
        '%(_PackageFiles.Extension)' == '.user' Or
        '%(_PackageFiles.Extension)' == '.suo' Or
        '%(_PackageFiles.Extension)' == '.secret' Or
        '%(_PackageFiles.Extension)' == '.key' Or
        '%(_PackageFiles.Extension)' == '.pem' Or
        '%(_PackageFiles.Extension)' == '.pfx' Or
        '%(_PackageFiles.Extension)' == '.snk'" />
    </ItemGroup>
    <Error Condition="'@(_ForbiddenPackageFile)' != ''" Text="Sensitive or internal content cannot be packed: @(_ForbiddenPackageFile)" />
  </Target>
</Project>
